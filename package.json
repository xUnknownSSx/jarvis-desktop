{
  "name": "jarvis-desktop",
  "version": "1.0.0",
  "description": "Standalone Jarvis Voice Assistant Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "JARVIS",
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
